[global]
    ### Display ###
    monitor = 0
    follow = mouse
    indicate_hidden = yes
    shrink = no
    transparency = 0
    separator_height = 1
    padding = 16
    horizontal_padding = 16
    separator_color = #2d2d2d;
    dmenu = /usr/bin/rofi -dmenu -p dunst:
    browser = /usr/bin/firefox -new-tab

    ### Icons ###
    icon_position = left
    max_icon_size = 48
    icon_path = /usr/share/icons/Papirus/16x16/status/:/usr/share/icons/Papirus/16x16/devices/:/usr/share/icons/Papirus/16x16/places/:/usr/share/icons/Papirus/16x16/actions/:/usr/share/icons/Papirus/16x16/apps/:/usr/share/icons/Papirus/16x16/mimetypes/

    ### Text ###
    font = FiraCode Nerd Font 11
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    ### Colors ###
    frame_color = #16a085
    frame_width = 2

    ### Animation ###
    corner_radius = 12
    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all

[urgency_low]
    background = #0a0a0a
    foreground = #e0e0e0
    frame_color = #2d2d2d
    timeout = 4

[urgency_normal]
    background = #1a1a1a
    foreground = #e0e0e0
    frame_color = #16a085
    timeout = 6

[urgency_critical]
    background = #e74c3c
    foreground = #ffffff
    frame_color = #c0392b
    timeout = 0 